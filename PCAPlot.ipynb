   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# 1. Load the PLINK eigenvector file\n",
    "eigenvec_path = r\"C:\\Users\\micha\\OneDrive\\Documents\\Thesis_data\\target_pca.eigenvec\"\n",
    "\n",
    "columns = ['FID', 'IID'] + [f'PC{i}' for i in range(1, 11)]\n",
    "pca_df = pd.read_csv(eigenvec_path, sep=r'\\s+', header=None, names=columns)\n",
    "\n",
    "# 2. Add Phenotype labels back for the plot legend\n",
    "# First 4 patients = Stroke Case, Last 6 patients = Healthy Control\n",
    "pca_df['Group'] = ['Stroke Case']*4 + ['Healthy Control']*6\n",
    "\n",
    "# 3. Create the PC Plot\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.scatterplot(\n",
    "    x='PC1', \n",
    "    y='PC2', \n",
    "    hue='Group', \n",
    "    style='Group',\n",
    "    data=pca_df, \n",
    "    s=100, \n",
    "    palette={'Stroke Case': '#d95f02', 'Healthy Control': '#1f77b4'})\n"
    "\n",
    "plt.title('Principal Component Analysis (PCA) of Study Cohort', fontsize=14, fontweight='bold', pad=15)\n",
    "plt.xlabel('Principal Component 1 (PC1)', fontsize=12)\n",
    "plt.ylabel('Principal Component 2 (PC2)', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.legend(title='Cohort Groups', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "plt.tight_layout()\n",
    "\n",
    "# Save the plot\n",
    "plt.savefig(r\"C:\\Users\\micha\\OneDrive\\Documents\\Thesis_data\\cohort_pca_plot.png\", dpi=300)\n",
    "plt.show()"
   ]
  }
 ],
